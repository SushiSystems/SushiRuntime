sr_[a-z_]+_tests # test programs the build names sr_<module>_tests in cmake/SushiRuntimeTests.cmake
TaskRecorder|RecordedGraph # classes of SushiBLAS, named as an example of an adapter
sycl/.* # headers of the SYCL toolchain, not of this repository
llvm-sycl/include/sycl/handler\.hpp # file of the intel/llvm bundle, cited for where SYCL allocates
StoreLambda # function of the intel/llvm SYCL headers
__FrameHandler3|GetUnwindTryBlock # function of the MSVC C++ runtime in which the ASan fault occurs
detect_stack_use_after_return # AddressSanitizer run-time option
enable_language # CMake command
sr_\w+_benchmarks # test program name sushiruntime_add_module_tests composes from the module name
cli/config\.local\.toml # the machine's own CLI config, gitignored and written by sr toolchain
applications/(probes|benchmarks)  # folders the shared probe checker names in tools/README.md; this repository has none
SushiProfiler::register_builtin_writers|register_builtin_writers # function of SushiProfiler, the profiler this repository links and does not hold
compare_records # function of SushiProfiler that refuses records whose build facts differ
SushiRuntime/profile/profile_config\.hpp # generated by the build from modules/foundation/profile/profile_config.hpp.in
