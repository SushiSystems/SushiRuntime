[Bb]uild/
# Sanitizer build trees (sr project build --type asan)
build-asan/
build-tsan/
bin/
lib/
out/

# Vendored dependencies fetched by `sr setup` (intel/llvm bundle, AdaptiveCpp,
# portable cmake/ninja, vcpkg). One self-contained, deletable folder.
dependencies/
docs/html
docs/api-site/html/
docs/api-site/doxygen-warnings.log
venv/

# IDEs
.vscode/
.vs/
*.swp
*.swo

# Machine-specific CLI config (committed config.toml holds shared defaults)
cli/config.local.toml
cli/config.local.toml.bak

# Python build / editable-install artifacts
cli/build/
cli/*.egg-info/
__pycache__/
*.py[cod]

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Docs
Doxyfile
html/
latex/
