@PACKAGE_INIT@

# SushiRuntimeConfig.cmake — what find_package(SushiRuntime) gives a consumer.
#
# The contract is deliberately narrow. A consumer gets the include directories,
# the library, and the floating-point semantics the library's header templates
# must be instantiated under. It does NOT get this project's warning flags, its
# sanitizer selection, or the ISA of the machine that happened to build it; those
# live on PRIVATE targets and never enter the export set. See
# docs/INTEGRATION.md for the toolchain contract this package assumes.

include(CMakeFindDependencyMacro)

# The public log headers include SushiLog, and the library links it.
find_dependency(SushiLog CONFIG)

# The package does not provide a SYCL compiler. The runtime's kernels are header templates a
# consumer instantiates in its own translation units, so the consumer's compiler is a SYCL
# compiler it configured itself. This file states which toolchain the library was built for
# and gives the consumer the add_sycl_to_target() command and IntelSYCL::SYCL_CXX target of
# that toolchain.
include("${CMAKE_CURRENT_LIST_DIR}/SushiRuntimeSycl.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/SushiRuntimeTargets.cmake")

# The exported options name no CUDA path; the consumer's toolkit supplies it.
set(SushiRuntime_NVIDIA "@SR_GPU_NVIDIA@")
if(SushiRuntime_NVIDIA AND TARGET SushiRuntime::gpu_offload)
    find_package(CUDAToolkit QUIET)
    if(NOT CUDAToolkit_FOUND)
        set(SushiRuntime_FOUND FALSE)
        set(SushiRuntime_NOT_FOUND_MESSAGE
            "SushiRuntime was built for NVIDIA targets and needs a CUDA toolkit, but none was "
            "found. Install one, or set CUDAToolkit_ROOT or the CUDA_PATH environment variable "
            "to its root.")
        return()
    endif()
    if(EXISTS "${CUDAToolkit_LIBRARY_ROOT}/nvvm/libdevice")
        target_compile_options(SushiRuntime::gpu_offload INTERFACE
            "--cuda-path=${CUDAToolkit_LIBRARY_ROOT}")
        target_link_options(SushiRuntime::gpu_offload INTERFACE
            "--cuda-path=${CUDAToolkit_LIBRARY_ROOT}")
    endif()
endif()

# Whether the distributed master-worker layer is compiled into this build, that is,
# whether <SushiRuntime/distributed/cluster.hpp> has a library behind it. The exported
# target defines SR_DISTRIBUTED when it is; no header reads the definition, so it
# changes no type.
set(SushiRuntime_DISTRIBUTED "@SR_ENABLE_DISTRIBUTED@")

# Whether this build compiled under the reproducible floating-point contract. A
# consumer whose replay must be byte-equal should assert this is ON.
set(SushiRuntime_DETERMINISTIC_FP "@SR_DETERMINISTIC_FP@")

check_required_components(SushiRuntime)
