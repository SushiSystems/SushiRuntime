# Doxygen configuration for the SushiRuntime public fluent API reference.
#
# Scope is deliberately the public surface only (include/SushiRuntime/api), the
# product's documented face. Lower layers are described in docs/ARCHITECTURE.md
# and are intentionally not part of this scripting-style reference. Build it with
# `sr doxygen` (or `doxygen Doxyfile`); output lands in docs/api-site/html.

PROJECT_NAME           = "SushiRuntime"
PROJECT_BRIEF          = "Orchestration runtime — fluent C++ API reference"
PROJECT_NUMBER         = "v1 (unreleased)"

OUTPUT_DIRECTORY       = docs/api-site
HTML_OUTPUT            = html
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Public fluent surface plus the hand-written manual landing and getting-started
# tour. The reference and the manual build together, Unity-manual style.
#
# docs/ARCHITECTURE.md is deliberately absent: it describes the layers beneath the
# public API, which this reference is scoped to exclude. The consequence is one
# expected warning — INTRODUCTION.md links to it, and that link cannot resolve
# inside the site. The link is right for GitHub, which is where the guide is read,
# so the warning is accepted rather than fixed. Any other warning is real.
INPUT                  = docs/api/mainpage.md \
                         docs/INTRODUCTION.md \
                         docs/INTEGRATION.md \
                         docs/CLI_GUIDE.md \
                         include/SushiRuntime/api
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api/mainpage.md

# Keep internal plumbing out of the scripting reference.
EXCLUDE_PATTERNS       = */detail/*
EXCLUDE_SYMBOLS        = *::detail *::detail::*

# Document the public API as written; do not invent docs for undocumented symbols,
# and surface anything public that is missing one so the site stays honest.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/api-site/doxygen-warnings.log

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SORT_MEMBER_DOCS       = YES
ALPHABETICAL_INDEX     = YES
SOURCE_BROWSER         = NO
QUIET                  = YES
