/**
 * @file profile_config.hpp
 * @brief Holds the profiling configuration the build chose; generated from profile_config.hpp.in.
 * @author Mustafa Garip
 * @see modules/foundation/profile/README.md
 */

#pragma once

/** @brief Whether the runtime reports to SushiProfiler: 1 or 0. A translation unit may state it first. */
#ifndef SR_ENABLE_PROFILER
#cmakedefine01 SR_ENABLE_PROFILER
#endif

/** @brief The deepest zone level compiled in: 0 none, 1 stages, 2 fine zones, 3 per-element zones. */
#ifndef SR_PROFILE_LEVEL
#define SR_PROFILE_LEVEL @SR_PROFILE_LEVEL@
#endif
